# Miscellaneous
!.gitignore
*.class
*.log
*.pyc
*.swp
*.swo
.DS_Store
._*
Thumbs.db
Desktop.ini
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.local/
.codegraph/

# Generated by Flutter from lib/l10n/*.arb.
/lib/l10n/app_localizations*.dart

# Local environment configuration; keep shareable examples.
.env
.env.*
!.env.example
!.env.*.example

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
